{
  "name": "@bakarr/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch main.ts",
    "start": "node build/main.js",
    "build": "tsx ./tools/generate-embedded-artifacts.ts && rolldown -c",
    "check": "tsc --noEmit",
    "generate:embedded-artifacts": "tsx ./tools/generate-embedded-artifacts.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@bakarr/shared": "workspace:*",
    "@effect/opentelemetry": "4.0.0-beta.102",
    "@effect/platform-node": "4.0.0-beta.102",
    "@effect/sql-sqlite-node": "4.0.0-beta.102",
    "@opentelemetry/api": "^1.9.1",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.102",
    "fast-xml-parser": "^5.10.1",
    "ipaddr.js": "^2.4.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.102",
    "@types/node": "26.1.1",
    "drizzle-kit": "1.0.0-rc.4",
    "rolldown": "^1.2.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
